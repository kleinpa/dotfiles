set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Switch to workspace
bindsym $mod+q workspace number $ws1
bindsym $mod+w workspace number $ws2
bindsym $mod+e workspace number $ws3
bindsym $mod+r workspace number $ws4
bindsym $mod+t workspace number $ws5
bindsym $mod+a workspace number $ws6
bindsym $mod+s workspace number $ws7
bindsym $mod+d workspace number $ws8
bindsym $mod+f workspace number $ws9
bindsym $mod+g workspace number $ws10

# Move focused container to workspace
bindsym $mod+Ctrl+q move container to workspace number $ws1
bindsym $mod+Ctrl+w move container to workspace number $ws2
bindsym $mod+Ctrl+e move container to workspace number $ws3
bindsym $mod+Ctrl+r move container to workspace number $ws4
bindsym $mod+Ctrl+t move container to workspace number $ws5
bindsym $mod+Ctrl+a move container to workspace number $ws6
bindsym $mod+Ctrl+s move container to workspace number $ws7
bindsym $mod+Ctrl+d move container to workspace number $ws8
bindsym $mod+Ctrl+f move container to workspace number $ws9
bindsym $mod+Ctrl+g move container to workspace number $ws10

# Switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# Move focused container to workspace
bindsym $mod+Ctrl+1 move container to workspace number $ws1
bindsym $mod+Ctrl+2 move container to workspace number $ws2
bindsym $mod+Ctrl+3 move container to workspace number $ws3
bindsym $mod+Ctrl+4 move container to workspace number $ws4
bindsym $mod+Ctrl+5 move container to workspace number $ws5
bindsym $mod+Ctrl+6 move container to workspace number $ws6
bindsym $mod+Ctrl+7 move container to workspace number $ws7
bindsym $mod+Ctrl+8 move container to workspace number $ws8
bindsym $mod+Ctrl+9 move container to workspace number $ws9
bindsym $mod+Ctrl+0 move container to workspace number $ws10

bindsym $mod+z exec ncmpcpp

bindsym $mod+Shift+$left workspace prev_on_output
bindsym $mod+Shift+$right workspace next_on_output
bindsym $mod+tab workspace back_and_forth

# No lock binding: the power menu ($mod+BackSpace) opens with lock under the
# cursor, so $mod+BackSpace, Enter does it. swayidle still uses $lock.

# Escape hatch: force every shell menu closed. If a menu ever holds an exclusive
# keyboard grab, this releases it without killing the session.
bindsym $mod+Shift+escape exec qs ipc call menus closeAll

bindsym $mod+F1 exec qs ipc call keymap toggle



#
# Status Bar
#

# No `bar` block: the bar is the quickshell config in config/quickshell, started
# from the autostart section below.

font RobotoMono Regular 9

default_border pixel 2
gaps inner 2
gaps outer 2

set $bg #17171700
set $fg #eff1f5
set $br #a0a0a0
set $ia #232425

client.focused          $br     $br     $fg     $bg       $br
client.focused_inactive $bg     $bg     $fg     $bg       $bg
client.unfocused        $bg     $bg     $fg     $bg       $bg
client.background $bg


### Output configuration

# No `output bg`: the wallpaper is a background layer-shell surface in the
# quickshell config, so there is one mechanism rather than two disagreeing.
# This black is only what shows in the moment before the shell starts.
output * bg #000000 solid_color

# swaymsg -t get_outputs

# living room
output 'LG Electronics LG TV SSCR2 0x01010101' res 2560x1440@119.998Hz scale 2

# office work
output 'Lenovo Group Limited T27hv-20 V3087CBZ' mode 2560x1440@74.780Hz pos 0 0
# output 'LG Electronics IPS231        211NDPH1W152' transform 270
output 'Dell Inc. DELL P2715Q 54KKD67JB6EL' res 3840x2160@29.981Hz scale 1.5 pos 2560 0
# output 'Dell Inc. DELL P2715Q 54KKD67JB6EL' res 2560x1440@59.951Hz
# office game
output 'Microstep MPG321UX OLED ' res 3840x2160@119.999Hz scale 1.5
output 'Microstep MPG321UX OLED 0x01010101' res 3840x2160@119.999Hz scale 1.5

# surface go
output 'Sharp Corporation LQ100P1JX51 Unknown' res 1800x1200@59.903Hz scale 2

set $laptop eDP-1
bindswitch --reload --locked lid:on output $laptop disable
bindswitch --reload --locked lid:off output $laptop enable

#
# Autostart
#

# The lock sleep/wake calls stop and restart the fingerprint reader: a verify
# does not survive suspend, and holding the reader open to a dark room is
# pointless. Harmless where there is no reader, or the screen is not locked.
exec swayidle -w \
    timeout 300 $lock \
    timeout 600 'swaymsg "output * dpms off"; qs ipc call lock sleep' \
    resume 'swaymsg "output * dpms on"; qs ipc call lock wake' \
    before-sleep 'qs ipc call lock lock; qs ipc call lock sleep' \
    after-resume 'qs ipc call lock wake'

# QS_ICON_THEME: nothing on a bare sway session tells Qt which icon theme is
# current, and without one the bar's symbolic icons resolve to nothing.
exec QS_ICON_THEME=Adwaita quickshell # bar, menus and lock screen
exec mako # notification daemon
# No `exec mpd`: the systemd user service already runs it, and starting a
# second one made the two fight over $XDG_RUNTIME_DIR/mpd/socket -- the stray
# rebound the path, so clients using the socket reached an empty daemon while
# clients using TCP reached the one actually playing.
