# Read `man 5 sway` for a complete reference.

# Variables

set $mod Mod4

# Direction keys
set $left j
set $down k
set $up l
set $right Semicolon

# The lock screen lives in the quickshell config, not in swaylock. Keep the
# quotes: sway strips them from an exec payload, and swayidle needs the whole
# thing to arrive as a single argument.
set $lock 'qs ipc call lock lock'

include /etc/sway/config-vars.d/*

### Common Input configuration

input "type:touchpad" {
    natural_scroll enabled
}

input "type:pointer" {
    accel_profile "flat"
    pointer_accel 0
}

### Key bindings

# Kill focused window
bindsym $mod+Ctrl+Backspace kill

bindsym $mod+Return exec alacritty

# Menus. Each of these toggles itself, so pressing the key again dismisses it.
# The launcher is on both $mod+u (top row, next to the other menus) and
# $mod+space (thumb+thumb on the corne, Cmd/Alt+Space muscle memory).
bindsym $mod+u exec qs ipc call launcher toggle
bindsym $mod+space exec qs ipc call launcher toggle
bindsym $mod+BackSpace exec qs ipc call power toggle
bindsym $mod+b exec qs ipc call keymap toggle
bindsym $mod+v exec qs ipc call network toggle
bindsym $mod+x exec qs ipc call audio toggle
bindsym $mod+c exec qs ipc call music toggle

# Drag floating windows by holding down $mod and left mouse button.
# Resize them with right mouse button + $mod.
# Despite the name, also works for non-floating windows.
# Change normal to inverse to use left mouse button for resizing and right
# mouse button for dragging.
floating_modifier $mod normal

smart_borders on

# No reload binding: it is in the power menu ($mod+BackSpace), and a rare
# action does not earn an unmodified home-row key.

# No exit binding: the power menu ($mod+BackSpace) has logout, and swaynag was
# never packaged here, so this shortcut had been broken rather than guarded.

# Move your focus around
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

# Move the focused window with the same, but add Shift
bindsym $mod+Ctrl+$left move left
bindsym $mod+Ctrl+$down move down
bindsym $mod+Ctrl+$up move up
bindsym $mod+Ctrl+$right move right

# Toggle orientation for next window
bindsym $mod+n splitt

# Switch the current container between different layout styles
bindsym $mod+i layout toggle split
bindsym $mod+o layout tabbed

# Make the current focus fullscreen
bindsym $mod+h fullscreen

# Toggle the current focus between tiling and floating mode
bindsym $mod+Ctrl+space floating toggle

# Swap focus between the tiling area and the floating area
bindsym $mod+Shift+space focus mode_toggle

# Move focus to the parent container
bindsym $mod+y focus parent

# Scratchpad
bindsym $mod+Ctrl+apostrophe move scratchpad
bindsym $mod+apostrophe scratchpad show

# Resizing containers:
bindsym $mod+m resize shrink width 5ppt
bindsym $mod+Comma resize grow height 5ppt
bindsym $mod+Period resize shrink height 5ppt
bindsym $mod+Slash resize grow width 5ppt

# Moving workspaces:
bindsym $mod+Alt+$right move workspace to output right
bindsym $mod+Alt+$left move workspace to output left
bindsym $mod+Alt+$down move workspace to output down
bindsym $mod+Alt+$up move workspace to output up

# Media keys. All of these go through the shell, which already tracks the
# sinks and the active player, rather than through a separate CLI per key.
bindsym XF86AudioRaiseVolume exec qs ipc call audio volumeUp
bindsym XF86AudioLowerVolume exec qs ipc call audio volumeDown
bindsym --locked XF86AudioMute exec qs ipc call audio mute
bindsym --locked XF86AudioMicMute exec qs ipc call audio micMute
bindsym XF86MonBrightnessDown exec qs ipc call brightness down
bindsym XF86MonBrightnessUp exec qs ipc call brightness up
bindsym --locked XF86AudioPlay exec qs ipc call media playPause
bindsym --locked XF86AudioNext exec qs ipc call media next
bindsym --locked XF86AudioPrev exec qs ipc call media prev

# ThinkPad call-control cluster (Fn+F9..F12). These emit KEY_PICKUP_PHONE and
# friends, which xkeyboard-config does map to real keysyms, so they need no
# udev/keyd remapping -- they were only doing nothing because nothing was bound.
bindsym --locked XF86PickupPhone exec qs ipc call media playPause
bindsym --locked XF86HangupPhone exec qs ipc call media next
bindsym --locked XF86LinkPhone exec qs ipc call media prev

#
# Workspaces
